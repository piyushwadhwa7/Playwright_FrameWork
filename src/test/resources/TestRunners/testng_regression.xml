<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="Opencart App Test Sanity suit" verbose="4" parallel="tests" thread-count="3">

    <listeners>
        <listener class-name="com.qa.opencart.listners.TestAllureListners"/>
    </listeners>

    <!-- Block number 1 -->
    <test name="Home  Page Test">
        <parameter name="browser" value="chromium"/>
        <classes>
            <class name="com.qa.opencart.tests.HomePageTest"/>
        </classes>
    </test>

    <!-- Block number 2 -->
    <test name="Login  Page Test">
        <parameter name="browser" value="chromium"/>
        <classes>
            <class name="com.qa.opencart.tests.LoginPageTest"/>
        </classes>
    </test>

    <!-- API Tests -->
    <test name="Users API Test">
        <classes>
            <class name="com.qa.opencart.tests.Users_Data_API"/>
        </classes>
    </test>

</suite>
